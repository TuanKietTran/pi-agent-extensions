{
  "name": "pi-macos-browser-control",
  "version": "0.1.0",
  "private": true,
  "description": "Native macOS browser automation for Pi with a tracked virtual mouse",
  "keywords": ["pi-package", "macos", "browser", "automation", "mouse", "vision"],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": ["./extensions/macos-browser-control.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:native": "mkdir -p .build && xcrun swiftc native/macos-controller.swift -o .build/macos-controller"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
